diff --git a/services/AudioPresentation.qml b/services/AudioPresentation.qml
new file mode 100644
index 0000000..55db594
--- /dev/null
+++ b/services/AudioPresentation.qml
@@ -0,0 +1,109 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+
+// Presentation hook for the audio device selectors (Nexus Audio page, bar
+// popout). A plugin such as dcqwqc/audiodevices registers itself as provider
+// to supply friendly names, hidden/grouped devices and smart selection. With
+// no provider the raw PipeWire lists are shown exactly as before.
+Singleton {
+    id: root
+
+    property QtObject provider: null
+    property bool revealSinks: false
+    property bool revealSources: false
+
+    readonly property int revision: provider ? provider.revision : 0
+
+    function register(p: QtObject): void {
+        provider = p;
+    }
+
+    function unregister(p: QtObject): void {
+        if (provider !== p)
+            return;
+        provider = null;
+        revealSinks = false;
+        revealSources = false;
+    }
+
+    function revealed(kind: string): bool {
+        return kind === "sink" ? revealSinks : revealSources;
+    }
+
+    function toggleReveal(kind: string): void {
+        if (kind === "sink")
+            revealSinks = !revealSinks;
+        else
+            revealSources = !revealSources;
+    }
+
+    // { entries: [{ key, label, sublabel, icon, isDefault, hidden, ref, ... }], hiddenCount }
+    function view(kind: string): var {
+        if (provider) {
+            try {
+                const v = provider.entries(kind, revealed(kind));
+                if (v && v.entries)
+                    return v;
+            } catch (e) {
+                console.warn("AudioPresentation: provider failed, showing raw devices:", e);
+            }
+        }
+        return fallback(kind);
+    }
+
+    function fallback(kind: string): var {
+        const nodes = kind === "sink" ? Audio.sinks : Audio.sources;
+        const current = kind === "sink" ? Audio.sink : Audio.source;
+        const entries = [...nodes].filter(n => n).map(n => ({
+                    key: n.name,
+                    kind: kind,
+                    label: n.description || n.name || qsTr("Unknown"),
+                    sublabel: "",
+                    icon: kind === "sink" ? "speaker" : "mic",
+                    ref: n,
+                    nodeName: n.name,
+                    isDefault: n.id === current?.id,
+                    routed: false,
+                    hidden: false
+                }));
+        entries.sort((a, b) => a.label.localeCompare(b.label));
+        return {
+            entries: entries,
+            hiddenCount: 0
+        };
+    }
+
+    function select(entry: var): void {
+        if (!entry)
+            return;
+        if (provider) {
+            try {
+                provider.select(entry);
+                return;
+            } catch (e) {
+                console.warn("AudioPresentation: provider select failed:", e);
+            }
+        }
+        if (!entry.ref)
+            return;
+        if (entry.kind === "source")
+            Audio.setAudioSource(entry.ref);
+        else
+            Audio.setAudioSink(entry.ref);
+    }
+
+    function displayName(node: var, kind: string): string {
+        if (!node)
+            return "";
+        if (provider) {
+            try {
+                const name = provider.displayName(node, kind);
+                if (name)
+                    return name;
+            } catch (e) {}
+        }
+        return node.description || node.name || "";
+    }
+}
